{
  "name": "product-catalog-service",
  "version": "1.0.0",
  "description": "Product catalog API with cursor-based pagination",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "db:generate": "prisma generate --schema=src/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=src/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema=src/prisma/schema.prisma",
    "db:seed": "node src/seed.js"
  },
  "prisma": {
    "schema": "src/prisma/schema.prisma",
    "seed": "node src/seed.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "prisma": "^6.9.0"
  }
}
